rules_version = '2';

// Reglas de `quehaypahacer-db` (develop y prod; coinciden con las activas al 2026-11-21, salvo el bloque de admin).
//
// Evidencia en código (2026-10-10): toda lectura/escritura pasa por Admin SDK
// (ignora estas reglas). El SDK cliente solo hace `onSnapshot` de lectura en:
//   - events/{id}                    EventForm (estado de media)
//   - events/{id}/sessions/{sid}     SessionForm
//   - sites/{id}                     estado del optimizer
// siempre del propio autor mientras edita. Todo lo demás: denegado.
service cloud.firestore {
  match /databases/{database}/documents {
    // Panel de administración (repo qhpa-admin): solo cuentas con el custom claim `admin`, que da únicamente
    // scripts/grant-admin.mjs con el Admin SDK. Las reglas se suman: este bloque no cambia lo que ya podían los autores.
    function isQhpaAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isAuthor(data) {
      return request.auth != null && data.author.id == request.auth.uid;
    }

    // resource == null: el doc aún no existe (wizard recién abierto).
    match /events/{eventId} {
      allow read: if resource == null || isAuthor(resource.data);

      match /sessions/{sessionId} {
        allow read: if request.auth != null
          && isAuthor(get(/databases/$(database)/documents/events/$(eventId)).data);
      }
    }

    match /sites/{siteId} {
      allow read: if resource == null || isAuthor(resource.data);
    }

    match /{document=**} {
      allow read, write: if isQhpaAdmin();
    }
  }
}
