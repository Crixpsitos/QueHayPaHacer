rules_version = '2';

// Reglas de prod (coinciden con las activas al 2026-11-21, salvo el bloque de admin).
// La app no usa el SDK de Storage: sube con URLs firmadas V4 (generateUploadUrl, requiere sesión) y lee por URL
// pública/firmada. Ninguna de las dos pasa por estas reglas, así que para el resto el SDK cliente queda cerrado.
// develop tiene además `match /public/{allPaths=**} { allow read: if true; }` (ver qhpa-admin/README).
service firebase.storage {
  match /b/{bucket}/o {
    // Panel de administración (repo qhpa-admin): solo cuentas con el claim `admin` suben imágenes (hasta 8 MB) a
    // `public/admin/` y a las carpetas de sitios y actividades que ya usa la app. Se leen por su URL con token.
    function adminImage() {
      return request.auth != null && request.auth.token.admin == true
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /public/admin/{allPaths=**} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if adminImage();
    }
    match /public/sites/{siteId}/images/{file} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if adminImage();
    }
    match /public/activities/{activityId}/images/{file} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if adminImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
